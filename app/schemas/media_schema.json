{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MediaGenerationRequest",
  "type": "object",
  "required": ["type", "prompt", "media", "quality", "extras"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["image", "video", "audio"]
    },
    "prompt": {
      "type": "string",
      "minLength": 10
    },
    "negative_prompt": {
      "type": ["string", "null"]
    },
    "style": {
      "type": ["string", "null"]
    },
    "media": {
      "type": "object"
    },
    "quality": {
      "type": "object"
    },
    "extras": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "image" } }
      },
      "then": {
        "properties": {
          "media": {
            "type": "object",
            "required": ["resolution", "aspect_ratio", "format"],
            "properties": {
              "resolution": {
                "type": "string",
                "pattern": "^\\d+x\\d+$"
              },
              "aspect_ratio": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": ["png", "jpg", "webp"]
              }
            },
            "additionalProperties": true
          },
          "quality": {
            "type": "object",
            "required": ["steps", "guidance", "upscale"],
            "properties": {
              "steps": {
                "type": "integer",
                "minimum": 10,
                "maximum": 100
              },
              "guidance": {
                "type": "number",
                "minimum": 1,
                "maximum": 20
              },
              "upscale": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "video" } }
      },
      "then": {
        "properties": {
          "media": {
            "type": "object",
            "required": ["resolution", "aspect_ratio", "duration", "fps", "format"],
            "properties": {
              "resolution": {
                "type": "string",
                "pattern": "^\\d+x\\d+$"
              },
              "aspect_ratio": {
                "type": "string"
              },
              "duration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "fps": {
                "type": "integer",
                "minimum": 12,
                "maximum": 60
              },
              "format": {
                "type": "string",
                "enum": ["mp4"]
              }
            },
            "additionalProperties": true
          },
          "quality": {
            "type": "object",
            "required": ["motion_strength", "stability", "camera_motion"],
            "properties": {
              "motion_strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "stability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "camera_motion": {
                "type": "string",
                "enum": ["static", "pan", "zoom", "orbit"]
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "audio" } }
      },
      "then": {
        "properties": {
          "media": {
            "type": "object",
            "required": ["duration", "format", "sample_rate"],
            "properties": {
              "duration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              },
              "format": {
                "type": "string",
                "enum": ["mp3", "wav"]
              },
              "sample_rate": {
                "type": "integer",
                "enum": [22050, 44100, 48000]
              }
            },
            "additionalProperties": true
          },
          "quality": {
            "type": "object",
            "required": ["voice_clarity", "background_noise"],
            "properties": {
              "voice_clarity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "background_noise": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}